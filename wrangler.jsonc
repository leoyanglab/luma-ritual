{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luma-ritual",
  "main": "src/worker.js",
  "account_id": "3d62edac1ba868f171c3ded08fa28fa2",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "glow.bool.win",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luma-ritual-demo",
      "database_id": "91cb66da-919e-4609-a7a4-5230e1ea1ded",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ]
}
